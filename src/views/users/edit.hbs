<div class="container mt-4">
  <a href="/users/{{user.id}}">← Volver al detalle</a>

  <h1 class="mb-4">Editar: {{user.firstName}} {{user.lastName}} {{user.email}} {{user.membershipType}} </h1>

  <form action="/users/{{user.id}}/edit" method="POST">
    <div>
      <label for="firstName">Nombre:</label>
      <input type="text" id="firstName" name="firstName" value="{{user.firstName}}" required>
    </div>
    <div>
      <label for="lastName">Apellido:</label>
      <input type="text" id="lastName" name="lastName" value="{{user.lastName}}" required>
    </div>
    <div>
      <label for="email">Email:</label>
      <input type="email" id="email" name="email" value="{{user.email}}" required>
    </div>
    <div>
      <label for="membershipType">Tipo de membresía:</label>
      <input type="text" id="membershipType" name="membershipType" value="{{user.membershipType}}" required>
    </div>
    <button type="submit">Guardar cambios</button>
  </form>
</div>
