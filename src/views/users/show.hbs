<a href="/users"> Back to Users</a>

<h1>{{user.firstName}} {{user.lastName}}</h1>
<p>Email: {{user.email}}</p>
<p>Membresía: {{user.membershipType}}</p>

<a href="/users/{{user.id}}/edit"><button>Editar</button></a>
<form action="/users/{{user.id}}/delete" method="POST" style="display:inline;">
  <button type="submit">Eliminar</button>
</form>

<hr>

<h2>Simulador de Citas</h2>
<form action="/users/{{user.id}}" method="GET">
  <div>
    <label for="amount">Monto de la cita: $</label>
    <input type="number" id="amount" name="amount" placeholder="Ingrese el monto" min="0" value="{{amount}}">
    <button type="submit">Calcular descuento</button>
  </div>
</form>
{{#if resultMessage}}
  <p id="result" style="margin-top: 10px; font-weight: bold;">{{resultMessage}}</p>
{{/if}}
