<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="mb-3">
      <a href="/affiliates/{{affiliate.id}}" class="text-decoration-none">← Volver al detalle</a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h1 class="h4 mb-4 text-primary fw-bold">Editar Afiliado</h1>

        <form action="/affiliates/{{affiliate.id}}/edit" method="POST" novalidate>
          <div class="row g-3">
            <div class="col-sm-6">
              <label for="firstName" class="form-label text-muted">Nombre</label>
              <input type="text" class="form-control {{#if errors.firstName}}is-invalid{{/if}}" id="firstName" name="firstName" value="{{affiliate.firstName}}">
              {{#if errors.firstName}}
                <div class="invalid-feedback">{{errors.firstName}}</div>
              {{/if}}
            </div>
            <div class="col-sm-6">
              <label for="lastName" class="form-label text-muted">Apellido</label>
              <input type="text" class="form-control {{#if errors.lastName}}is-invalid{{/if}}" id="lastName" name="lastName" value="{{affiliate.lastName}}">
              {{#if errors.lastName}}
                <div class="invalid-feedback">{{errors.lastName}}</div>
              {{/if}}
            </div>
            <div class="col-12">
              <label for="email" class="form-label text-muted">Email</label>
              <input type="email" class="form-control {{#if errors.email}}is-invalid{{/if}}" id="email" name="email" value="{{affiliate.email}}">
              {{#if errors.email}}
                <div class="invalid-feedback">{{errors.email}}</div>
              {{/if}}
            </div>
            <div class="col-12">
              <label for="membershipType" class="form-label text-muted">Membresía</label>
              <input type="text" class="form-control {{#if errors.membershipType}}is-invalid{{/if}}" id="membershipType" name="membershipType" value="{{affiliate.membershipType}}">
              {{#if errors.membershipType}}
                <div class="invalid-feedback">{{errors.membershipType}}</div>
              {{/if}}
              <div class="form-text text-muted">Membresías válidas: <b>Silver</b> (5%), <b>Gold</b> (10%), o <b>Platinum</b> (15% de descuento).</div>
            </div>
            <div class="col-12 mt-4">
              <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-bold">Guardar cambios</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
