<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="mb-3">
      <a href="/affiliates" class="text-decoration-none">← Volver a Afiliados</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <h1 class="h3 card-title text-primary mb-1">{{affiliate.firstName}} {{affiliate.lastName}}</h1>
            <p class="text-muted mb-0">{{affiliate.email}}</p>
          </div>
          <span class="badge bg-primary rounded-pill fs-6">{{affiliate.membershipType}}</span>
        </div>

        <div class="d-flex gap-2 mt-4">
          <a href="/affiliates/{{affiliate.id}}/edit" class="btn btn-outline-primary">Editar perfil</a>
          <form action="/affiliates/{{affiliate.id}}/delete" method="POST" class="m-0" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este afiliado?');">
            <button type="submit" class="btn btn-outline-danger">Eliminar</button>
          </form>
        </div>
      </div>
    </div>

    <div class="card shadow-sm border-0 bg-white">
      <div class="card-body p-4">
        <h2 class="h5 card-title text-secondary mb-3">Simulador de Citas</h2>
        <form action="/affiliates/{{affiliate.id}}" method="GET" class="row g-3 align-items-end">
          <div class="col-sm-8">
            <label for="amount" class="form-label text-muted">Monto de la cita (CLP)</label>
            <div class="input-group">
              <span class="input-group-text bg-light">$</span>
              <input type="number" class="form-control" id="amount" name="amount" placeholder="Ej: 50000" min="0" value="{{amount}}">
            </div>
          </div>
          <div class="col-sm-4">
            <button type="submit" class="btn btn-success w-100 shadow-sm">Calcular descuento</button>
          </div>
        </form>
        {{#if resultMessage}}
          <div class="alert alert-success mt-4 mb-0 border-0 shadow-sm" role="alert">
            {{resultMessage}}
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>
